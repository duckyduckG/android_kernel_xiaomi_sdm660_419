# Platform
CONFIG_MACH_XIAOMI_WHYRED=y

# Camera
CONFIG_MSMB_CAMERA_LEGACY=y

# Hall sensor
CONFIG_INPUT_HALL_SENSOR_E7S=y

# Touchscreen
CONFIG_TOUCHSCREEN_NVT_E7S=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_I2C=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_CORE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_RMI_DEV=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_FW_UPDATE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_GESTURE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_E7S_TEST_REPORTING=y

# KernelSU_next
CONFIG_KSU=y
CONFIG_KSU_WITH_KPOBES=y
# Susfs
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=n
# Kprobes
CONFIG_KPROBES=n
CONFIG_HAVE_KPROBES=n
CONFIG_KPROBE_EVENTS=n
